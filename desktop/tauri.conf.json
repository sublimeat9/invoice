{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electronic Invoicing",
  "version": "0.1.0",
  "identifier": "app.invoicing.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../web build:tauri",
    "frontendDist": "../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Electronic Invoicing",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
